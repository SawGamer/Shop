# Copy to .env to override docker-compose defaults. Never commit the real .env.

# Accounts created on first start
SHOP_ADMIN_EMAIL=admin@za-shop.local
SHOP_ADMIN_PASSWORD=admin12345
SHOP_DEMO_CUSTOMER_EMAIL=customer@za-shop.local
SHOP_DEMO_CUSTOMER_PASSWORD=customer12345

# Payments: "fake" shows a built-in test payment page; "stripe" uses Stripe Checkout (test keys work)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Infrastructure secrets (change for anything that is not your laptop)
POSTGRES_PASSWORD=shop
MEILI_MASTER_KEY=dev-master-key-change-me
S3_ACCESS_KEY=shopdev
S3_SECRET_KEY=shopdev-secret-key
